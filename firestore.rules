rules_version = '2';
// ============================================================
// Reglas de seguridad de Firestore para Dibujo (lovedrawing-33b5a).
// Pega estas reglas en: Firebase Console → Firestore → Rules.
//
// Modelo:
//  users/{uid}                — perfil y presencia (dueño escribe; su pareja lee)
//  invites/{code}             — códigos de invitación temporales
//  couples/{cid}              — espacio privado (solo los 2 miembros)
//  couples/{cid}/messages     — chat
//  couples/{cid}/live         — trazos colaborativos en vivo
//  couples/{cid}/signals      — señales efímeras (escribiendo…)
//  couples/{cid}/drawings     — tarjetas de dibujos compartidos
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(cid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
    }

    match /users/{uid} {
      allow read: if signedIn();
      // El dueño escribe su perfil. Además, quien se vincula puede fijar el
      // coupleId del invitador (única clave que puede tocar un tercero).
      allow create, update: if signedIn() && (
        request.auth.uid == uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId'])
      );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow delete: if signedIn();
    }

    match /couples/{cid} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow read, update: if isMember(cid);

      match /{col}/{doc} {
        allow read, write: if isMember(cid);
      }
    }
  }
}
